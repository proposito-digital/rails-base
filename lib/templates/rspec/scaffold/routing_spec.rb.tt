require "rails_helper"

<% module_namespacing do -%>
RSpec.describe Admin::<%= controller_class_name.sub(/\AAdmin::/, "") %>Controller, type: :routing do
  describe "routing" do

<% unless options[:singleton] -%>
    it "routes to #index" do
      expect(get: "/admin/<%= controller_file_name %>").to route_to("admin/<%= controller_file_name %>#index")
    end

<% end -%>
    it "routes to #new" do
      expect(get: "/admin/<%= controller_file_name %>/new").to route_to("admin/<%= controller_file_name %>#new")
    end

    it "routes to #show" do
      expect(get: "/admin/<%= controller_file_name %>/1").to route_to("admin/<%= controller_file_name %>#show", id: "1")
    end

    it "routes to #edit" do
      expect(get: "/admin/<%= controller_file_name %>/1/edit").to route_to("admin/<%= controller_file_name %>#edit", id: "1")
    end

    it "routes to #create" do
      expect(post: "/admin/<%= controller_file_name %>").to route_to("admin/<%= controller_file_name %>#create")
    end

    it "routes to #update" do
      expect(put: "/admin/<%= controller_file_name %>/1").to route_to("admin/<%= controller_file_name %>#update", id: "1")
    end

    it "routes to #destroy" do
      expect(delete: "/admin/<%= controller_file_name %>/1").to route_to("admin/<%= controller_file_name %>#destroy", id: "1")
    end

  end
end
<% end -%>
