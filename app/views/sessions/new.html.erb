<div class="flex min-h-screen items-center justify-center bg-gradient-to-br from-rose-200 via-rose-100 to-white px-4 py-10">
  <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 shadow-xl">
    <%= render 'partials/messages' %>

    <div class="text-center">
      <%= image_tag 'logo-slogan.png', alt: "[Nome do Projeto]", id: 'logo', class: "mx-auto mb-4 w-56" %>
      <p class="text-sm text-slate-500">Welcome Back</p>
    </div>

    <%= form_with url: session_path, class: "mt-6 space-y-4" do |form| %>
      <div>
        <label for="email" class="form-label">E-mail</label>
        <%= form.email_field :email_address, class: "form-control", required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email_address] %>
      </div>

      <div data-controller="password-toggle">
        <label for="password" class="form-label">Password</label>
        <div class="relative">
          <%= form.password_field :password, class: "form-control pr-10", data: { password_toggle_target: "input" }, spellcheck: false, autocorrect: :off, autocapitalize: :off, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72 %>

          <button type="button" class="absolute inset-y-0 right-0 inline-flex items-center justify-center px-3 text-slate-500 hover:text-slate-700" data-action="password-toggle#toggle" aria-label="Mostrar senha"> <i class="bi bi-eye" data-password-toggle-target="icon"></i>
          </button>
        </div>
      </div>

      <div class="flex items-center justify-between text-sm">
        <a class="text-slate-400">Don't have an account?</a>
        <%= link_to "Forgot password?", new_password_path, class: "font-medium" %>
      </div>

      <%= form.submit "Sign in", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
