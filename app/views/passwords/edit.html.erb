<div class="flex min-h-dvh items-center justify-center bg-gradient-to-br from-rose-200 via-rose-100 to-white px-3 py-6 sm:px-4 sm:py-10">
  <div class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-4 shadow-lg sm:rounded-2xl sm:p-8 sm:shadow-xl">
    <%= render 'partials/messages' %>

    <div class="text-center">
      <%= image_tag 'logo-slogan.png', alt: "[Nome do Projeto]", id: 'logo', class: "mx-auto mb-4 w-44 sm:w-56" %>
      <p class="text-sm text-slate-500">Update your password</p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-4" do |form| %>
      <div>
        <label for="password" class="form-label">Password</label>
        <%= form.password_field :password, required: true, class: "form-control", autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72 %>
      </div>

      <div>
        <label for="password_confirmation" class="form-label">Password Confirmation</label>
        <%= form.password_field :password_confirmation, required: true, class: "form-control", autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72 %>
      </div>

      <div class="flex flex-col gap-1 text-sm sm:flex-row sm:items-center sm:justify-between">
        <a class="text-slate-400">Don't have an account?</a>
        <%= link_to "login?", new_session_path, class: "font-medium" %>
      </div>

      <%= form.submit "Reset Password", class: "btn-primary h-11 w-full" %>
    <% end %>
  </div>
</div>
