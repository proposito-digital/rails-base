<% content_for :stylesheet do %>
  <%#= stylesheet_link_tag 'index' %>
<% end %>

<div class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold text-slate-800"><%= model_plural_translation %></h1>
    <a class="btn-primary" href="<%= instance_new_path %>">
      <%= ui_icon("plus", classes: "mr-2 size-4") %><%= translate_view_shared('add', model_name: model_singular_translation) %>
    </a>
  </div>

  <% if @instances.nil? %>
    <div class="rounded-2xl border border-slate-200 bg-white px-6 py-12 text-center shadow-sm">
      <h2 class="text-3xl font-bold text-slate-800"><%= translate_view_index('no_instances', { model_name: model_plural_translation.downcase }) %></h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600"><%= translate_view_index('new_instance', { model_name: model_singular_translation.downcase }) %></p>
      <div class="mt-6">
        <a class="btn-primary" href="<%= instance_new_path %>">
          <%= ui_icon("plus", classes: "mr-2 size-4") %><%= translate_view_index('new_button', model_name: model_singular_translation.downcase) %>
        </a>
      </div>
    </div>
  <% else %>
    <div class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
      <form id="form_search" action="<%= instances_index_path %>" method="get" class="flex items-center">
        <input type="search"
               id="input-search"
               class="form-control rounded-r-none border-r-0"
               name="term"
               value="<%= params[:term] %>"
               placeholder="<%= translate_view_shared('search_placeholder', model_name: model_plural_translation.downcase) %>"
               aria-label="Search"
               aria-describedby="Search field">
        <button type="submit" class="inline-flex h-[42px] w-12 items-center justify-center rounded-r-lg border border-slate-300 bg-slate-50 text-slate-600 hover:bg-slate-100" aria-label="Search">
          <%= ui_icon("search", classes: "size-4") %>
        </button>
      </form>
    </div>

    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <% model_column_names.excluding('id', 'deleted_at', 'password_digest').take(5).each do |attribute| %>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">
                <%= sort_link("#{model_plural_name_to_sort}.#{attribute}", attribute_translation(model_singular_name, attribute)) %>
              </th>
            <% end %>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-600">&nbsp;</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-100">
          <% @instances.each do |instance| %>
            <tr id="tr_<%= "#{instance.class.name}_#{instance.id}" %>" class="hover:bg-slate-50">
              <% instance.attributes.excluding('id', 'deleted_at', 'password_digest').take(5).each do |name, value| %>
                <td class="px-4 py-3 text-sm text-slate-700">
                  <% if value.instance_of?(ActiveSupport::TimeWithZone) %>
                    <%= translate_datetime_format_default(value, "dt_at") %>
                  <% else %>
                    <%= value %>
                  <% end %>
                </td>
              <% end %>

              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-1">
                  <%= action_button href: instance_show_path(instance), instance: instance, action: :show?, icon: "eye", title: translate_view_shared('show') %>
                  <%= action_button href: instance_edit_path(instance), instance: instance, action: :edit?, icon: "pencil-square", title: translate_view_shared('edit') %>
                  <%= modal_button href: instance_remove_path(instance), instance: instance, action: :destroy?, icon: "trash", title: translate_view_shared('remove'), modal_id: "modal_destroy_#{instance.id}" %>
                </div>
              </td>
            </tr>

            <%= render partial: 'modal_destroy', locals: { instance: instance, url: instance_remove_path(instance), model_name: model_singular_translation } %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-3 text-sm text-slate-500"><%== @pagy.info_tag %></div>
    <div data-controller="pagy-initializer">
      <%== @pagy.input_nav_js if @pagy.pages > 1 %>
    </div>
  <% end %>
</div>
