<% content_for :stylesheet do %>
  <%#= stylesheet_link_tag 'show' %>
<% end %>

<div class="w-full space-y-3 sm:space-y-4">
  <%= link_to instances_index_path, class: "inline-flex items-center gap-2 text-sm font-medium text-slate-700 hover:text-slate-900" do %>
    <%= icon("chevron-left", class: "size-4") %>
    <%= translate_view_shared("back") %>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h3 class="text-base font-semibold text-slate-800 sm:text-lg"><%= model_singular_translation %> - <%= @instance.id %></h3>
      <%= link_to instance_edit_path(@instance), class: 'btn-primary w-full sm:w-auto' do %>
        <%= icon("square-pen", class: "mr-2 size-4") %><%= translate_view_shared("edit") %>
      <% end %>
    </div>

    <fieldset disabled>
      <%= form_for @instance, url: '', method: '' do |f| %>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          <% @instance.attributes.excluding('id', 'deleted_at', 'created_at', 'updated_at', 'password_digest').each do |name, _value| %>
            <div>
              <%= f.label name, attribute_translation(model_singular_name_to_translate(@instance), name), class: 'form-label' %>
              <%= f.text_field name, class: 'form-control', id: "#{model_field_id(@instance, name)}" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </fieldset>
  </div>
</div>
