<% content_for :stylesheet do %>
  <%#= stylesheet_link_tag 'edit' %>
<% end %>

<div class="w-full space-y-4">
  <%= link_to instances_index_path, class: "inline-flex items-center gap-2 text-sm font-medium text-slate-700 hover:text-slate-900" do %>
    <%= icon("chevron-left", class: "size-4") %>
    <%= translate_view_shared("back") %>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h3 class="text-lg font-semibold text-slate-800"><%= "#{model_singular_translation} - #{@instance.id}" %></h3>
      <%= link_to translate_view_shared("show"), instance_show_path(@instance), class: "btn-secondary" %>
    </div>

    <%= form_for @instance, url: instance_update_path(@instance), method: 'patch' do |f| %>
      <%= render partial: 'form_errors' %>

      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        <% @instance.attributes.excluding('id', 'deleted_at', 'created_at', 'updated_at', 'password_digest').each do |name, _value| %>
          <div>
            <%= f.label name, attribute_translation(model_singular_name_to_translate(@instance), name), class: 'form-label' %>
            <%= f.text_field name, class: 'form-control', id: "#{model_field_id(@instance, name)}" %>
          </div>
        <% end %>
      </div>

      <div class="mt-6 flex flex-wrap justify-end gap-2">
        <%= link_to translate_view_shared("show"), instance_show_path(@instance), class: "btn-secondary" %>
        <%= f.submit translate_view_shared("save"), class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
