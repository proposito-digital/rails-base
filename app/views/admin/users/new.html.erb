<% content_for :stylesheet do %>
  <%#= stylesheet_link_tag 'edit' %>
<% end %>

<div class="w-full space-y-3 sm:space-y-4">
  <%= link_to instances_index_path, class: "inline-flex items-center gap-2 text-sm font-medium text-slate-700 hover:text-slate-900" do %>
    <%= icon("chevron-left", class: "size-4") %>
    <%= translate_view_shared("back") %>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <h3 class="text-base font-semibold text-slate-800 sm:text-lg"><%= translate_view_shared('new_title', model_name: model_singular_translation) %></h3>
    </div>

    <%= form_for @instance, url: instance_create_path, multipart: true, method: 'post', html: { novalidate: true } do |f| %>
      <%= render partial: 'form_errors' %>

      <div class="mt-4 grid grid-cols-1 gap-4">
        <div>
          <%= f.label :email_address, attribute_translation(model_singular_name_to_translate(@instance), :email_address), class: 'form-label' %>
          <%= f.text_field :email_address, class: 'form-control', id: "#{model_field_id(@instance, :email_address)}" %>
        </div>

        <div>
          <%= f.label :password, attribute_translation(model_singular_name_to_translate(@instance), :password), class: 'form-label' %>
          <%= f.password_field :password, class: 'form-control', id: "#{model_field_id(@instance, :password)}" %>
        </div>
      </div>

      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <%= link_to translate_view_shared("cancel"), instances_index_path, class: "btn-secondary w-full sm:w-auto" %>
        <%= f.submit translate_view_shared("save"), class: "btn-primary w-full sm:w-auto" %>
      </div>
    <% end %>
  </div>
</div>
