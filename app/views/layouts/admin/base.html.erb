<!DOCTYPE html>
<html lang="en">
  <!-- BEGIN HEAD -->
  <%= render 'layouts/admin/head' %>
  <!-- END HEAD -->
  <body>
    <!-- BEGIN ADMIN CONTENT -->
    <div id="appAdmin" v-cloak class="min-h-screen bg-slate-100">
      <!-- BEGIN NAVBAR -->
      <%= render 'layouts/admin/navbar' %>
      <!-- END NAVBAR -->
      <div class="flex">
        <!-- BEGIN SIDEBAR -->
        <%= render 'layouts/admin/sidebar' %>
        <!-- END SIDEBAR -->

        <div class="h-[91vh] w-full overflow-y-auto px-4 py-4 md:px-6 lg:px-8">
          <%= render "layouts/admin/messages" %>
          <!-- BEGIN MAIN CONTENT -->
          <main class="pt-2">
            <%= yield %>
            <%= render "layouts/admin/footer" %>
          </main>
          <!-- END MAIN CONTENT -->
        </div>
      </div>
    </div>
    <!-- END ADMIN CONTENT -->
  </body>

  <% console if Rails.env.development? %>
</html>
