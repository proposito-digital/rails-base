<nav id="sidebar" class="hidden h-[91vh] shrink-0 md:block" data-controller="sidebar">
  <div class="flex justify-end px-3 pt-4">
    <button type="button"
            id="toggle-sidebar-button"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-transparent"
            data-action="sidebar#toggle"
            data-sidebar-target="toggleButton"
            aria-expanded="true"
            aria-label="Recolher menu lateral">
      <i class="bi bi-list text-xl"></i>
    </button>
  </div>

  <div class="px-3 pb-4 pt-8">
    <ul class="space-y-1">
      <% @menu.each do |menu_item| %>
        <% if policy(menu_item[:policy]).menu? %>
          <li>
            <% if menu_item.key?(:items) %>
              <button class="sidebar-link flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium <%= menu_item[:active] ? 'active' : '' %>"
                      type="button"
                      data-hs-collapse="#<%= menu_item[:id_collapse] %>"
                      aria-controls="<%= menu_item[:id_collapse] %>"
                      aria-expanded="<%= menu_item[:active] ? 'true' : 'false' %>">
                <i class="<%= menu_item[:icon] %> text-lg"></i>
                <span class="item-name ml-3 flex-1 truncate"><%= menu_item[:name] %></span>
                <i class="bi bi-chevron-down sidebar-toggle-arrow text-xs"></i>
              </button>

              <div class="hs-collapse <%= menu_item[:active] ? '' : 'hidden' %>" id="<%= menu_item[:id_collapse] %>">
                <ul class="sidebar-submenu mt-1 space-y-1 pl-8">
                  <% menu_item[:items].each do |submenu| %>
                    <% if policy(submenu[:policy]).menu? %>
                      <li>
                        <a href="<%= url_for(submenu[:url]) %>"
                           class="sidebar-link flex items-center rounded-lg px-3 py-2 text-sm <%= submenu[:active] ? 'active' : '' %>">
                          <i class="<%= submenu[:icon] %> text-base"></i>
                          <span class="item-name ml-3 truncate"><%= submenu[:name] %></span>
                        </a>
                      </li>
                    <% end %>
                  <% end %>
                </ul>
              </div>
            <% else %>
              <a class="sidebar-link flex items-center rounded-lg px-3 py-2 text-sm font-medium <%= menu_item[:active] ? 'active' : '' %>"
                 aria-current="page"
                 href="<%= url_for(menu_item[:url]) if menu_item[:url].present? %>">
                <i class="<%= menu_item[:icon] %> text-lg"></i>
                <span class="item-name ml-3 truncate"><%= menu_item[:name] %></span>
              </a>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>
</nav>
