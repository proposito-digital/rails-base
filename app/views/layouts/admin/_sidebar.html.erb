<div id="hs-application-sidebar"
     class="hs-overlay [--auto-close:lg] hs-overlay-open:translate-x-0 -translate-x-full fixed inset-y-0 start-0 z-50 hidden h-full w-64 transform border-e border-slate-200 bg-white transition-all duration-300 lg:block lg:translate-x-0"
     role="dialog"
     tabindex="-1"
     aria-label="Sidebar">
  <div class="relative flex h-full max-h-full flex-col">
    <div class="flex items-center border-b border-slate-100 px-6 py-4">
      <a href="/admin" class="inline-flex items-center" aria-label="Propósito Digital">
        <%= image_tag 'logo-slogan.png', alt: 'Propósito Digital', class: 'h-9 w-auto object-contain' %>
      </a>
    </div>

    <div class="h-full overflow-y-auto p-3 [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-md [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-slate-300/80">
      <nav class="hs-accordion-group w-full" data-hs-accordion-always-open>
        <ul class="flex flex-col space-y-1">
          <% @menu.each_with_index do |menu_item, index| %>
            <% next unless policy(menu_item[:policy]).menu? %>
            <% active_menu = menu_item[:active] %>
            <% item_classes = active_menu ? 'bg-slate-100 text-slate-900' : 'text-slate-700 hover:bg-slate-100' %>

            <% if menu_item.key?(:items) %>
              <% accordion_id = "sidebar-accordion-#{index}" %>
              <% child_id = menu_item[:id_collapse].presence || "#{accordion_id}-child" %>

              <li class="hs-accordion" id="<%= accordion_id %>">
                <button type="button"
                        class="hs-accordion-toggle flex w-full items-center gap-x-3.5 rounded-lg px-2.5 py-2 text-start text-sm font-medium transition <%= item_classes %>"
                        aria-expanded="<%= active_menu ? 'true' : 'false' %>"
                        aria-controls="<%= child_id %>">
                  <%= icon(menu_item[:icon], class: "size-4 shrink-0") %>
                  <span class="flex-1 truncate"><%= menu_item[:name] %></span>

                  <svg class="hs-accordion-active:block ms-auto hidden size-4 text-slate-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m18 15-6-6-6 6"></path>
                  </svg>

                  <svg class="hs-accordion-active:hidden ms-auto block size-4 text-slate-500" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </button>

                <div id="<%= child_id %>"
                     class="hs-accordion-content w-full overflow-hidden transition-[height] duration-300 <%= active_menu ? '' : 'hidden' %>"
                     role="region"
                     aria-labelledby="<%= accordion_id %>">
                  <ul class="space-y-1 ps-8 pt-1">
                    <% menu_item[:items].each do |submenu| %>
                      <% next unless policy(submenu[:policy]).menu? %>
                      <% active_submenu = submenu[:active] %>
                      <% submenu_classes = active_submenu ? 'bg-slate-100 text-slate-900' : 'text-slate-700 hover:bg-slate-100' %>

                      <li>
                        <a href="<%= url_for(submenu[:url]) %>"
                           class="flex items-center gap-x-3.5 rounded-lg px-2.5 py-2 text-sm transition <%= submenu_classes %>">
                          <%= icon(submenu[:icon], class: "size-4 shrink-0") %>
                          <span class="truncate"><%= submenu[:name] %></span>
                        </a>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </li>
            <% else %>
              <li>
                <a href="<%= url_for(menu_item[:url]) if menu_item[:url].present? %>"
                   class="flex items-center gap-x-3.5 rounded-lg px-2.5 py-2 text-sm font-medium transition <%= item_classes %>"
                   aria-current="<%= active_menu ? 'page' : nil %>">
                  <%= icon(menu_item[:icon], class: "size-4 shrink-0") %>
                  <span class="truncate"><%= menu_item[:name] %></span>
                </a>
              </li>
            <% end %>
          <% end %>
        </ul>
      </nav>
    </div>
  </div>
</div>
