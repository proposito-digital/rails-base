<div id="language_select" class="hs-dropdown relative inline-flex [--placement:bottom-right]">
  <button id="language-dropdown"
          type="button"
          class="hs-dropdown-toggle inline-flex items-center gap-x-2 rounded-lg px-3 py-2 text-sm font-medium text-white/90 transition hover:bg-white/10 hover:text-white">
    <span><%= get_language_name locale %></span>
    <i class="bi bi-chevron-down text-xs"></i>
  </button>

  <div class="hs-dropdown-menu absolute right-0 z-20 mt-2 hidden min-w-44 rounded-xl border border-slate-200 bg-white p-1.5 shadow-lg">
    <% I18n.available_locales.each do |available_locale| %>
      <%= link_to url_for(locale: available_locale),
        class: "flex items-center gap-2 rounded-md px-3 py-2 text-sm transition #{locale == available_locale ? 'bg-slate-100 font-medium text-slate-900' : 'text-slate-700 hover:bg-slate-100'}" do %>
        <span class="flag-icon <%= get_locale_flag_icon available_locale %>"></span>
        <span><%= get_language_name available_locale %></span>
      <% end %>
    <% end %>
  </div>
</div>
