<header class="sticky top-0 z-50 border-b border-white/10 bg-[var(--background-navbar)] shadow-sm">
  <div class="flex items-center justify-between gap-4 px-4 py-2 md:px-6">
    <a href="/admin" class="shrink-0">
      <%= image_tag 'logo-white.png', alt: "[Nome do Projeto]", id: "navbar-logo", class: "object-contain" %>
    </a>

    <button class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-white hover:bg-white/10 md:hidden"
            type="button"
            data-hs-collapse="#header-navbar"
            aria-controls="header-navbar"
            aria-label="Toggle navigation">
      <i class="bi bi-list text-xl"></i>
    </button>

    <div id="header-navbar" class="hs-collapse hidden w-full grow md:block md:w-auto">
      <div class="mt-3 flex flex-col gap-3 md:mt-0 md:flex-row md:items-center md:justify-end md:gap-2">
        <%= render partial: 'layouts/admin/language_select' %>
        <%= render 'layouts/admin/user_profile' %>
      </div>
    </div>
  </div>
</header>
<%#= render partial: 'admin/users/change_password'%>
